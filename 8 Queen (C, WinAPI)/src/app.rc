/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAIN                BITMAP                  "res\\toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAIN                ICON                    "res\\app.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAIN MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&Method"
    BEGIN
        MENUITEM "&First\tHome",                ID_METHOD_FIRST
        MENUITEM "&Prev\tPgUp",                 ID_METHOD_PREV
        MENUITEM "&Next\tPgDn",                 ID_METHOD_NEXT
        MENUITEM "&Last\tEnd",                  ID_METHOD_LAST
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Options...",                 ID_TOOLS_OPTION
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About 8 Queen...",           ID_HELP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAIN ACCELERATORS 
BEGIN
    VK_F1,          ID_HELP_ABOUT,          VIRTKEY, NOINVERT
    VK_HOME,        ID_METHOD_FIRST,        VIRTKEY, NOINVERT
    VK_END,         ID_METHOD_LAST,         VIRTKEY, NOINVERT
    VK_NEXT,        ID_METHOD_NEXT,         VIRTKEY, NOINVERT
    VK_PRIOR,       ID_METHOD_PREV,         VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUT DIALOGEX 0, 0, 220, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About 8 Queen"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAIN,IDC_STATIC,13,14,20,20
    LTEXT           "8 Queen 1.0",IDC_STATIC,49,15,41,8,SS_NOPREFIX
    LTEXT           "© 2006.  By Tolken Ahmetolla.",IDC_STATIC,49,35,99,8
    DEFPUSHBUTTON   "OK",IDOK,160,10,50,14,WS_GROUP
END

IDD_OPTION DIALOGEX 0, 0, 154, 134
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Pick an area and choose color",IDC_STATIC,7,7,140,99,WS_GROUP
    CONTROL         "",IDC_STA_PREVIEW,"Static",SS_GRAYRECT | SS_NOTIFY,15,21,124,61,WS_EX_CLIENTEDGE
    CONTROL         "Use &window color for background",IDC_CHK_BACKGROUND,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,89,122,10
    DEFPUSHBUTTON   "OK",IDOK,43,113,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,97,113,50,14
END


