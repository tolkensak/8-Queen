    EDITTEXT        IDC_EDT_ORDER,310,117,50,14,ES_CENTER | ES_AUTOHSCROLL | ES_NOHIDESEL
    CONTROL         "",IDC_SPN_ORDER,"msctls_updown32",UDS_WRAP | UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS,349,135,11,14
    PUSHBUTTON      "&Close",IDC_BTN_CLOSE,310,212,50,14
END


