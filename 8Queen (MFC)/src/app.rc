IDD_ABOUT DIALOGEX 0, 0, 225, 62
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About 8 Queen"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    ICON            "",IDC_STA_PIECE_ICON,15,12,20,20
    CTEXT           "",IDC_STA_PIECE_TEXT,15,39,21,8,NOT WS_GROUP
    LTEXT           "8 Queen 1.0",IDC_STATIC,56,15,40,8,SS_NOPREFIX
    LTEXT           "© 2000.  By Tolken Ahmetolla.",IDC_STATIC,56,32,98,8
    DEFPUSHBUTTON   "OK",IDOK,168,11,45,14
END

IDD_MAIN DIALOGEX 0, 0, 372, 263
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "8 Queen"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         400,IDC_STA_BOARD,"Static",SS_BITMAP | WS_TABSTOP,7,7,271,250,WS_EX_DLGMODALFRAME
    CONTROL         401,IDC_STA_EYE,"Static",SS_BITMAP | SS_NOTIFY,325,21,20,18
